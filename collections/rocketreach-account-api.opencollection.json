{
  "opencollection": "1.0.0",
  "info": {
    "name": "RocketReach Account API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Api-Key",
      "value": "{{Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "RocketReach API Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rocketreach.co/api/v2/account/",
            "auth": {
              "type": "apikey",
              "key": "Api-Key",
              "value": "{{Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve & Manage Account Details"
        },
        {
          "info": {
            "name": "Get a RocketReach API Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rocketreach.co/api/v2/account/key/",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Api-Key",
              "value": "{{Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create New API Key"
        },
        {
          "info": {
            "name": "⭐ RocketReach Universal API Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rocketreach.co/api/v2/universal/account/",
            "auth": {
              "type": "apikey",
              "key": "Api-Key",
              "value": "{{Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve & Manage Account Details"
        }
      ]
    }
  ],
  "bundled": true
}